# autoreconf -i
Makefile.in
/aclocal.m4
/ar-lib
/autom4te.cache/
/compile
/configure
/depcomp
/install-sh
/libexfat/config.h.in
/missing

# ./configure
.deps/
Makefile
# ...but amiga/Makefile is hand-written, not generated, and it is the
# whole Amiga build: every ROM switch and its reasoning lives there.
# It sat untracked for the life of this repo because of the rule above.
!amiga/Makefile
/config.log
/config.status
/libexfat/config.h
/libexfat/stamp-h1

# make
*.o
/attrib/exfatattrib
/dump/dumpexfat
/fsck/exfatfsck
/fuse/mount.exfat-fuse
/label/exfatlabel
/libexfat/libexfat.a
/mkfs/mkexfatfs

# Amiga build output and macOS litter
amiga/build/
amiga/obj/
.DS_Store
